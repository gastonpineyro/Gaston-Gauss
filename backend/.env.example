# Copiá este archivo como ".env" y completá los valores. NUNCA subas el .env a GitHub.
PORT=3000

# Base de datos PostgreSQL
DATABASE_URL=postgres://gauss:CAMBIAR_CLAVE@localhost:5432/gauss

# Clave secreta para firmar las sesiones del panel (texto largo y al azar, 40+ caracteres)
JWT_SECRET=CAMBIAR_POR_UN_TEXTO_LARGO_Y_AL_AZAR
# Cuántas horas dura la sesión del panel
SESION_HORAS=12

# Páginas autorizadas a hablar con este servidor (separadas por coma, sin barra final)
ORIGENES_PERMITIDOS=https://gastonpineyro.github.io,https://www.TUDOMINIO.com.ar,https://TUDOMINIO.com.ar

# Carpeta donde se guardan los comprobantes subidos
CARPETA_ARCHIVOS=./archivos
# URL pública de este servidor (para armar los links de los comprobantes)
URL_PUBLICA=https://api.TUDOMINIO.com.ar

# Mercado Pago (opcional, dejalo vacío mientras no lo uses)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Dirección de la página (para volver desde Mercado Pago)
SITE_URL=https://www.TUDOMINIO.com.ar
